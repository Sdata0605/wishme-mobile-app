root = true

# Line endings are left to git (core.autocrlf) on purpose: most committed files are CRLF, some are LF, and forcing
# one here would make editors rewrite whole files on save.
[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{kt,java,gradle}]
indent_size = 4
