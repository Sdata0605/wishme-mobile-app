{
  "expo": {
    "name": "WishMe",
    "slug": "mobile",
    "owner": "prashantuser5",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prashantuser1.wishme",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow WishMe to recognise your speech so you can use the voice assistant.",
        "NSMicrophoneUsageDescription": "Allow WishMe to use the microphone for voice commands.",
        "NSContactsUsageDescription": "Allow WishMe to read your contacts so the assistant can call people by name.",
        "NSCameraUsageDescription": "Allow WishMe to use the camera so you can scan QR codes to pay.",
        "NSPhotoLibraryUsageDescription": "Allow WishMe to open your photo library so you can pick photos for your wishes.",
        "NSPhotoLibraryAddUsageDescription": "Allow WishMe to save the wishes and photos you create to your photo library."
      }
    },
    "android": {
      "package": "com.prashantuser1.wishme",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_CONTACTS",
        "android.permission.CALL_PHONE",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "./plugins/withLauncherQueries",
      "expo-media-library",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow WishMe to access your camera to scan QR codes for payments."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow WishMe to use the microphone for voice commands.",
          "speechRecognitionPermission": "Allow WishMe to recognise your speech so you can use the voice assistant."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow WishMe to read your contacts so the voice assistant can call people you ask for."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF6B33",
          "defaultChannel": "reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "8f4bc8a6-1ec4-4fcf-9c79-cdd909a76344"
      }
    }
  }
}
