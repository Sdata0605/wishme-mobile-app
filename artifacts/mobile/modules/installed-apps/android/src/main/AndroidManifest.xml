<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Lets this app see every app that has a launcher icon (Android 11+ package visibility), without the restricted
       QUERY_ALL_PACKAGES permission. Merged into the app's manifest. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>
</manifest>
